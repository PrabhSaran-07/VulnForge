# Backend environment (local development)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://vulnforge:vulnforge_password@localhost:5433/vulnforge?schema=public
# Optional direct PostgreSQL connection for migrations; DATABASE_URL is used if unset.
DIRECT_URL=
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=replace_with_a_strong_session_secret_at_least_32_characters
# JSON key-version to base64-encoded 32-byte-or-longer HMAC key map; required for production flag verification and local AUTH lab seeding.
VULNFORGE_FLAG_HMAC_KEYS=
# Local-only authentication labs. Never enable on a public deployment.
VULNFORGE_ENABLE_LOCAL_AUTH_LAB=true
# Required by seed:auth-lab; keep distinct flags only in your ignored local .env.
VULNFORGE_AUTH_LAB_FLAGS=
# Local-only access-control labs. Never enable on a public deployment.
VULNFORGE_ENABLE_LOCAL_ACCESS_LAB=false
# Required by seed:access-lab; keep distinct flags only in your ignored local .env.
VULNFORGE_ACCESS_LAB_FLAGS=
# Set this only in your local, git-ignored .env file when provisioning the development test admin.
VULNFORGE_TEST_ADMIN_PASSWORD=
# Optional: set the chosen test student password locally to enable account verification tests.
VULNFORGE_TEST_STUDENT_PASSWORD=
